{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hamid",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b8a606f4-9d16-45d5-b799-4b40d81e39b0","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "512764e9d10f427c87c94496d7bc4ad3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
